{
  "name": "2dcad-viewer",
  "version": "0.1.0",
  "private": true,
  "description": "서버 없이 브라우저에서 DXF·DWG 도면을 열고 측정하는 2D CAD 뷰어 (OpenCAD)",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build && npm run check:seo",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "check:seo": "node tools/check-seo.mjs",
    "update:content-dates": "vite build && node tools/update-content-dates.mjs",
    "test:seo": "node --test tools/seo.test.mjs"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "jsdom": "22.1.0",
    "typescript": "^7.0.2",
    "vite": "^7.3.7",
    "vitest": "^3.2.7"
  },
  "dependencies": {
    "earcut": "^3.2.4",
    "opentype.js": "^2.0.0",
    "pdfjs-dist": "6.3.289"
  }
}
